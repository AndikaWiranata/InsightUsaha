# Supabase (Project Settings > API). URL wajib diisi.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Rahasia: hanya dipakai di server (API route), jangan pernah diberi awalan NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# AI untuk ringkasan dan Tanya Data
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Dipakai bila kuota harian model utama habis (HTTP 429)
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# Payment gateway (kosong = mode simulasi)
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false

# Rahasia endpoint cron harian /api/cron/langganan
CRON_SECRET=
